{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "NodeNext",

    "jsx": "react-jsx",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "verbatimModuleSyntax": false,

    "types": ["jest", "node", "chrome", "vite/client"],

    "noEmit": true
  },
  "include": ["src", "tests"]
}
